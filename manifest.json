{
  "manifest_version": 3,
  "name": "Roughly Righter",
  "version": "1.4.0",
  "description": "Inofficiellt tillägg för Roughly Right. Ge menyer och rubriker egna namn och fördela Kvar över flera månader.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.roughlyright.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.roughlyright.com/*"
      ],
      "js": [
        "kvar.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Roughly Righter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
